#!/usr/bin/env sh

set -eu

SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
INSTALL_DIR="$HOME/.atom"

COMMAND="${1:-}"
shift

case "$COMMAND" in
    update)
        . "$SCRIPT_DIR/../lib/commands/update.sh"
        update "$@"
        ;;
    rmpycache)
        . "$SCRIPT_DIR/../lib/commands/rmpycache.sh"
        rmpycache "$@"
        ;;
    src)
        . "$SCRIPT_DIR/../lib/commands/scr.sh"
        scr "$@"
        ;;
    sshup)
        . "$SCRIPT_DIR/../lib/commands/sshup.sh"
        sshup "$@"
        ;;
    repo-tree)
        . "$SCRIPT_DIR/../lib/commands/repo-tree.sh"
        repo_tree "$@"
        ;;
    version)
        . "$SCRIPT_DIR/../lib/commands/version.sh"
        version "$@"
        ;;
    vscode)
        . "$SCRIPT_DIR/../lib/commands/vscode.sh"
        vscode "$@"
        ;;
    sshc)
        . "$SCRIPT_DIR/../lib/commands/sshc.sh"
        sshc "$@"
        ;;
    repos)
        . "$SCRIPT_DIR/../lib/commands/repos.sh"
        status_repos "$@"
        ;;
    server)
        . "$SCRIPT_DIR/../lib/commands/server.sh"
        server "$@"
        ;;
    pem)
        . "$SCRIPT_DIR/../lib/commands/pem.sh"
        pem "$@"
        ;;
    *)
        echo "Command not found"
        ;;
esac

Host ghp
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_ghp
    IdentitiesOnly yes # Fuerza el uso exclusivo de la clave, causa problemas si tienes varias claves
    AddKeysToAgent yes # Agrega automaticamente al ssh-agent
Host server-repo
   HostName ec2-54-90-163-56.compute-1.amazonaws.com
   User ubuntu
   IdentityFile ~/.ssh/server-repo.pem
Host server-test
    HostName ec2-3-84-136-183.compute-1.amazonaws.com
    User ubuntu
    IdentityFile ~/.ssh/server-test.pem