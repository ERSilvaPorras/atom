#!/usr/bin/env sh

set -eu

SCRIPT_PATH="$(readlink -f "$0")"
echo "SCRIPT_PATH: $SCRIPT_PATH"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

COMMAND="${1:-}"
shift

case "$COMMAND" in
    update)
        . "$SCRIPT_DIR/../lib/update.sh"
        update "$@"
        ;;
    *)
        echo "Command not found"
        ;;
esac
