#!/usr/bin/env sh

set -eu

SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

COMMAND="${1:-}"
shift

case "$COMMAND" in
    update)
        . "$SCRIPT_DIR/../lib/update.sh"
        update "$@"
        ;;
    rmpycache)
        . "$SCRIPT_DIR/../lib/rmpycache.sh"
        rmpycache "$@"
        ;;
    src)
        . "$SCRIPT_DIR/../lib/scr.sh"
        scr "$@"
        ;;
    sshup)
        . "$SCRIPT_DIR/../lib/sshup.sh"
        sshup "$@"
        ;;
    repo-tree)
        . "$SCRIPT_DIR/../lib/repo-tree.sh"
        repo_tree "$@"
        ;;
    version)
        . "$SCRIPT_DIR/../lib/version.sh"
        version "$@"
        ;;
    *)
        echo "Command not found"
        ;;
esac
